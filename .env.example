# Copy to .env (gitignored) and fill in. Also copied to the Pi by `make push`.

# The Pi that make commands target. For a second Pi, override on the command
# line, e.g. `make upgrade IP=192.168.1.3 HOST=pihole2.tailnet-name.ts.net`.
# Static LAN address (also what `make setup` assigns)
IP=192.168.1.2
# Hostname `make setup` gives the Pi
NAME=pihole
# Where SSH connects. Leave empty to use IP; set to a Tailscale name to work remotely.
HOST=

# The user you created in Raspberry Pi Imager
PI_USER=pi

# Web UI password (http://<ip>/admin)
PIHOLE_PASSWORD='change-me'

TZ=America/Chicago

# The Pi's own default gateway (the UDM)
GATEWAY=192.168.1.1
